<?xml version="1.0" encoding="utf-8"?>
<nvi name="cufft_dev_${{version}}" title="${{title}}" version="${{version}}" versionText="${{version}}" hidden="ARP" timestamp="2025-05-31T14:42:50" disposition="default" installerMin="2.1002.191.1621" allowsCustomPath="true" bare="true" preserveCache="false" diskSpaceForBare="1">
	<strings>
		<string name="version" value="12.9"/>
		<string name="cufftLibRootDir" value="${{ProgramFiles}}\NVIDIA GPU Computing Toolkit\CUDA"/>
		<string name="cufftLibInstallDir" value="${{cufftLibRootDir}}\v${{version}}"/>
		<localized locale="0x0409">
			<string name="title" value="CUFFT Development"/>
		</localized>
	</strings>
	<description/>
	<dependencies>
		<package type="requires" package="CUDADevelopment_${{version}}"/>
	</dependencies>
	<customInstallTree>
		<treeNode text="CUFFT" ordering="CUDA|Development|Compiler|Libraries" accessibility="selectable"/>
	</customInstallTree>
	<properties>
		<string name="InstallLocation" value="${{cufftLibInstallDir}}"/>
		<bool name="FixedInstallLocation" value="true"/>
