HKR,,FailureActions,%REG_BINARY%,0a,00,00,00,00,00,00,00,01,00,00,00,03,00,00,00,14,00,00,00,01,00,00,00,70,17,00,00,01,00,00,00,40,1f,00,00,03,00,00,00,10,27,00,00
