HKR,,FailureCommand,%REG_SZ%,"cmd.exe /C %13%\Display.NvContainer\NvContainerRecovery.bat NVDisplay.ContainerLocalSystem %%ProgramData%%\NVIDIA\NvContainerRecoveryNVDisplay.ContainerLocalSystem.log"
HKR,,ImagePath,%REG_EXPAND_SZ%,"%13%\Display.NvContainer\NVDisplay.Container.exe -s NVDisplay.ContainerLocalSystem -f %%ProgramData%%\NVIDIA\NVDisplay.ContainerLocalSystem.log -l 3 -d %13%\Display.NvContainer\plugins\LocalSystem -r -p 30000 -cfg NVDisplay.ContainerLocalSystem\LocalSystem /ert"
HKR,,LocalSystem,%REG_SZ%,"LocalSystem Container Hive"
HKR,,Session,%REG_SZ%,"Session Container Hive"

