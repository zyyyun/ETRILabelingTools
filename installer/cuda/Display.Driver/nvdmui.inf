HKR,"LocalSystem\NvXDCore",DisableLoad,%REG_DWORD_NO_CLOBBER%,0x00000002
HKR,"LocalSystem\NvcDispCorePlugin",DisableLoad,%REG_DWORD%,0x00000000
HKR,"LocalSystem\NvcDispCorePlugin",LogFile,%REG_SZ%,"%%ProgramData%%\NVIDIA\NvcDispCorePlugin.log"
HKR,"LocalSystem\NvcDispCorePlugin",LogLevel,%REG_DWORD%,0x00000003
HKR,"LocalSystem\NvcDispWatchdog",DisableLoad,%REG_DWORD_NO_CLOBBER%,0x00000002
HKR,"LocalSystem\Watchdog",LogFile,%REG_SZ%,"%%ProgramData%%\NVIDIA\NVDisplayContainerWatchdog.log"
HKR,"LocalSystem\Watchdog\Session",Container,%REG_SZ%,"%13%\Display.NvContainer\NVDisplay.Container.exe"
HKR,"LocalSystem\Watchdog\Session",Folder,%REG_SZ%,"%13%\Display.NvContainer\plugins\Session"
HKR,"LocalSystem\Watchdog\Session",GenerateDump,%REG_DWORD%,0x00000000
HKR,"LocalSystem\Watchdog\Session",Parameters,%REG_SZ%,"-f %%ProgramData%%\NVIDIA\DisplaySessionContainer%%d.log -d %13%\Display.NvContainer\plugins\Session -r -l 3 -p 30000 -cfg NVDisplay.ContainerLocalSystem\Session /ert"
