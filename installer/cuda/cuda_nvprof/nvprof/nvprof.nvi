			<copyFile target="LICENSE"/>
		</standard>
	</phases>
	<manifest>
		<file name="bin\cuinj64_129.dll" sizeKB="1482"/><file name="bin\nvprof.exe" sizeKB="2165"/><file name="LICENSE" sizeKB="62"/><file name="nvprof.nvi" sizeKB="2"/></manifest>
