	<forms>
		<form name="PostInstallCustomFormPathEnvVarWarn" base="!PostInstallTemplate">
			<control name="headText" text="${{EnvPathWarning}}"/>
			<control name="WarningMessage" style="label" x="137pt" y="83pt" width="294pt" height="68pt" text="${{PathEnvVarWarningMessage}}"/>
			<control name="cudaToolkitWarning" class="richedit" x="137pt" y="135pt" width="294pt" height="125pt" font="smallText" text="${CUDAVisualProfilerEnvPathContent}" readOnly="true" vScroll="true" multiLine="true" enabledTextColor="0xb7bebd" bkgndColor="0x394a4a"/>
			<control name="back" hidden="true" disabled="true"/>
			<control name="cancel" hidden="true" disabled="true"/>
			<control name="next" style="smallPrimaryButton" x="366pt" y="280pt" onClick="!NextFormGroup"/>
		</form>
	</forms>
