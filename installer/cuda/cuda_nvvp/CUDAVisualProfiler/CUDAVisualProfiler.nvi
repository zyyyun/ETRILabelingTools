<?xml version="1.0" encoding="utf-8"?>
<nvi name="visual_profiler_${{version}}" title="${{title}}" version="${{version}}" versionText="${{version}}" hidden="ARP" timestamp="2025-05-31T14:42:06" disposition="default" installerMin="2.1002.191.1621" allowsCustomPath="true" bare="true" preserveCache="false" diskSpaceForBare="104">
	<strings>
		<string name="version" value="12.9"/>
		<string name="visualProfilerRootDir" value="${{ProgramFiles}}\NVIDIA GPU Computing Toolkit\CUDA"/>
		<string name="visualProfilerInstallDir" value="${{visualProfilerRootDir}}\v${{version}}"/>
		<string name="CUDAProgramGroup" value="NVIDIA Corporation\CUDA Toolkit\v${{version}}"/>
		<localized locale="0x0409">
			<string name="title" value="Visual Profiler"/>
			<string name="PathEnvVarWarningMessage" value="The NVIDIA Installer needs to add a path to the %PATH% environment variable; however, doing so would exceed the maximum length possible for this variable. After the installation has been completed, please shorten the %PATH% environment variable. And then prepend below mentioned paths to the %PATH% environment variable after the installation, or else try the installation again."/>
			<string name="InstallWarning" value="Do you want to continue?"/>
			<string name="EnvPathWarning" value="CUDA Toolkit installation warning"/>
		</localized>
	</strings>
	<description/>
	<dependencies>
		<package type="requires" package="CUDADevelopment_${{version}}"/>
	</dependencies>
	<customInstallTree>
		<treeNode text="Visual Profiler" ordering="CUDA|Development|Tools" accessibility="selectable"/>
	</customInstallTree>
	<constraints>
	</constraints>
	<properties>
		<string name="InstallLocation" value="${{visualProfilerInstallDir}}"/>
		<bool name="FixedInstallLocation" value="true"/>
		<string name="DownloadUrl" value="http://developer.download.nvidia.com/compute/cuda/12.9.1/network_installers/windows/x86_64/wddm2/CUDAVisualProfiler.exe"/></properties>
	<extensions>
		<extension file="CUDAVisualProfilerExt.dll"/>
	</extensions>
	<phases>
		<custom name="CheckEnvPathVariableSize" when="install" action="CheckEnvPathVariableSize"/>
		<standard phase="setPathVar" condition="DecideSetPathVar">
			<addPath position="first" target="${{InstallLocation}}\libnvvp"/>
			<addPath position="first" target="${{InstallLocation}}\bin"/>
		</standard>
		<standard onError="ignore" phase="addNvvpToReg" when="install">
			<addRegistry keyName="HKEY_CLASSES_ROOT\.nvvp" type="REG_SZ" value="nvvp_auto_file" valueName=""/>
			<addRegistry keyName="HKEY_CLASSES_ROOT\nvvp_auto_file\shell\open\command" type="REG_SZ" value="&quot;${{InstallLocation}}\libnvvp\nvvp.exe&quot; &quot;%1&quot;" valueName=""/>
			<addRegistry keyName="HKEY_CLASSES_ROOT\nvvp_auto_file\DefaultIcon" type="REG_SZ" value="&quot;${{InstallLocation}}\libnvvp\nvvp.exe&quot;" valueName=""/>
		</standard>
		<standard onError="ignore" phase="deleteRegistryKeys" when="uninstall">
			<deleteRegistryKeyTree keyName="HKEY_CLASSES_ROOT\nvvp_auto_file"/>
			<deleteRegistryKeyTree keyName="HKEY_CLASSES_ROOT\.nvvp"/>
		</standard>
